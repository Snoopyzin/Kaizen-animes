# Address of the Kaizen account/subscription server (no trailing slash, without /api).
# Development: the local PHP server (server/dev) listens on http://localhost:8080
# Production:  your HostGator domain, e.g. https://kaizen.seudominio.com.br
VITE_KAIZEN_SERVER=http://localhost:8080

# Login / subscription portal. Switched off for now; set to true to require login + subscription.
VITE_KAIZEN_AUTH=false

# "Follow on Instagram" screen shown once before the app. On by default; false leaves it out.
# VITE_KAIZEN_FOLLOW_GATE=false

# Biblioteca (movies & series from the user's own Jellyfin server). Off in released builds; true includes
# its header button and routes (the backend code is always present but inert until a server is connected).
# VITE_KAIZEN_LIBRARY=true
